# IMAP account that receives the mail
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USERNAME=kaneo@example.com
IMAP_PASSWORD=CHANGEME
IMAP_ROOT=API

# Kaneo instance and an API key of a user with write access to the target projects
KANEO_URL=https://kaneo.example.com
KANEO_API_KEY=CHANGEME

# Seconds between polls. 0 runs once and exits.
POLL_INTERVAL=300
LOG_LEVEL=info
