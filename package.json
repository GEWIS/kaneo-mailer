{
  "name": "kaneo-mailer",
  "version": "0.0.0",
  "private": true,
  "description": "Turn emails in an IMAP folder into Kaneo tasks",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --ignore-path .gitignore --check .",
    "format:fix": "prettier --ignore-path .gitignore --write .",
    "postinstall": "husky || true"
  },
  "dependencies": {
    "imapflow": "^2.2.6",
    "log4js": "^6.9.1",
    "mailparser": "^3.9.36"
  },
  "devDependencies": {
    "@gewis/eslint-config-typescript": "^2.4.0",
    "@gewis/prettier-config": "^2.2.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GEWIS/kaneo-mailer.git"
  },
  "bugs": {
    "url": "https://github.com/GEWIS/kaneo-mailer/issues"
  },
  "homepage": "https://github.com/GEWIS/kaneo-mailer#readme",
  "author": "GEWIS",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.18.1"
}
